<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">

	<display-name>QuickChat - Fredon Immobilier</display-name>

	<welcome-file-list>
		<welcome-file>immo/index.jsp</welcome-file>
	</welcome-file-list>

	<!-- FILTRE URL (réécriture d'URL) -->
	<filter>
		<filter-name>UrlFilter</filter-name>
		<filter-class>com.quickchat.filter.UrlFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>UrlFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- FILTRE ENCODAGE -->
	<filter>
		<filter-name>CharacterEncodingFilter</filter-name>
		<filter-class>com.quickchat.utils.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>CharacterEncodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- FILTRE AUTHENTIFICATION ADMIN -->
	<filter>
		<filter-name>AdminAuthFilter</filter-name>
		<filter-class>com.quickchat.filter.AdminAuthFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>AdminAuthFilter</filter-name>
		<url-pattern>/admin/*</url-pattern>
	</filter-mapping>

	<!-- FILTRE ANTI-CACHE ET SÉCURITÉ (empêche retour après déconnexion) -->
	<filter>
		<filter-name>CacheControlFilter</filter-name>
		<filter-class>com.quickchat.filter.CacheControlFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>CacheControlFilter</filter-name>
		<url-pattern>/admin/*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>CacheControlFilter</filter-name>
		<url-pattern>/chat</url-pattern>
	</filter-mapping>

	<!-- CONFIGURATION DES SESSIONS -->
	<session-config>
		<session-timeout>60</session-timeout>
		<cookie-config>
			<http-only>true</http-only>
			<secure>false</secure>
		</cookie-config>
	</session-config>
	

</web-app>